const vertexShaderSource = `
attribute vec3 inVertex;
attribute vec3 inNormal;
attribute vec3 inTangent;
attribute vec2 inTexCoords;

varying vec2 outTexCoords;
varying vec3 vPosition;
varying vec3 vNormal;
varying mat3 vTBN;

uniform mat4 ModelViewMatrix;
uniform mat4 ModelViewProjectionMatrix;
uniform mat4 NormalMatrix;

void main() {
    vec4 fragPosition = ModelViewMatrix * vec4(inVertex, 1.0);
    vPosition = fragPosition.xyz;
    outTexCoords = inTexCoords;

    vec3 N = normalize((NormalMatrix * vec4(inNormal, 0.0)).xyz);
    vNormal = N;

    vec3 T = normalize((NormalMatrix * vec4(inTangent, 0.0)).xyz);

    T = normalize(T - dot(T, N) * N);

    vec3 B = cross(N, T);

    vTBN = mat3(T, B, N);

    gl_Position = ModelViewProjectionMatrix * vec4(inVertex, 1.0);
}
`;

const fragmentShaderSource = `
#ifdef GL_FRAGMENT_PRECISION_HIGH
   precision highp float;
#else
   precision mediump float;
#endif

varying vec2 outTexCoords;
varying vec3 vPosition;
varying vec3 vNormal;
varying mat3 vTBN;

uniform float ambientStrength;
uniform float specularStrength;
uniform float shininess;
uniform vec3 lightPosition;
uniform vec3 viewPosition;
uniform sampler2D diffTexture;
uniform sampler2D specTexture;

void main() {
    vec3 norm = normalize(vNormal);

    vec3 lightDir = normalize(lightPosition - vPosition);
    vec3 viewDir = normalize(viewPosition - vPosition);
    vec3 reflectDir = reflect(-lightDir, norm);

    float diff = max(dot(norm, lightDir), 0.0);
    vec3 diffuseColor = texture2D(diffTexture, outTexCoords).rgb;
    vec3 diffuse = diff * diffuseColor;

    float spec = pow(max(dot(viewDir, reflectDir), 0.0), shininess);
    vec3 specularColor = texture2D(specTexture, outTexCoords).rgb;
    vec3 specular = spec * specularStrength * specularColor;

    vec3 ambient = ambientStrength * diffuseColor;

    vec3 finalColor = ambient + diffuse + specular;
    gl_FragColor = vec4(finalColor, 1.0);
}
`;